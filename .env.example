# Construction E-commerce Marketplace Environment Variables
# Copy to .env.local for local development

# Supabase Credentials (Required for remote Postgres, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_CHECKOUT_TEST_MODE=true
NEXT_PUBLIC_PAYMENT_INTEGRATION_STATUS=deferred
